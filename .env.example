# ---- Copy this file to .env and fill it in ----

# Login tokens. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Encrypts stored Meta access tokens. Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Never change it after saving a WhatsApp account, or the saved token can't be decrypted.
ENCRYPTION_KEY=change-me

# First login, created automatically on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_ORG_NAME=My Business
ALLOW_SIGNUP=false

# true = fake sending and fake delivery updates (no Meta account needed)
WHATSAPP_MOCK=true

# From Meta App Dashboard > App settings > Basic > App secret
META_APP_SECRET=
# Any random string. Enter the same value in Meta's dashboard when setting the webhook URL.
WEBHOOK_VERIFY_TOKEN=change-me
GRAPH_API_VERSION=v24.0

# Sending speed. Meta allows ~80/second per number by default.
SEND_RATE_PER_SECOND=20
SEND_CONCURRENCY=8

FRONTEND_ORIGIN=http://localhost:3000
